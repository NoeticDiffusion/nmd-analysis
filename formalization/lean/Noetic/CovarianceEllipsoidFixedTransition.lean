import Noetic.CovarianceEllipsoidPushForward

/-!
# L10C: affine fixed-transition reachability ellipsoids

This module specializes the L10B affine push-forward equivalence to the
finite-horizon covariance generated by a fixed transition `A`, innovation
factor `B`, and horizon `h`.  The covariance remains proof-carrying: an
explicit `hPos` witness is required before the ordinary inverse ellipsoid is
constructed.  The affine map is likewise guarded by an explicit `IsUnit F`
witness.

The statements are finite real linear-algebra facts.  They do not identify an
ellipsoid with a probability support, empirical confidence region, occupancy,
or biological controllability set.
-/

namespace NoeticDiffusion

noncomputable section

open scoped Matrix

variable {n : Type*} [Fintype n]

local instance covarianceEllipsoidFixedTransitionDecidableEq : DecidableEq n :=
  Classical.decEq n

/-- The affine image of a licensed fixed-transition inverse ellipsoid.

The constructor requires both the fixed-transition covariance's positive-
definiteness witness and the affine map's invertibility witness. -/
def affineFixedTransitionReachabilityEllipsoid
    (F : Matrix n n ℝ) (c : n → ℝ)
    (A B : Matrix n n ℝ) (h : ℕ)
    (hPos : (covariance A (B * B.transpose) h).PosDef)
    (hF : IsUnit F) : Set (n → ℝ) :=
  affinePushForwardEllipsoid F c
    (⟨hPos⟩ : LicensedInverseEllipsoid (covariance A (B * B.transpose) h)) hF

/-- Membership in the affine fixed-transition ellipsoid is equivalent to
membership in the inverse ellipsoid of the pushed-forward covariance,
centered at the explicit affine center. -/
theorem affineFixedTransitionReachabilityEllipsoid_mem_iff_centeredInverseEllipsoid
    (F : Matrix n n ℝ) (c : n → ℝ)
    (A B : Matrix n n ℝ) (h : ℕ)
    (hPos : (covariance A (B * B.transpose) h).PosDef)
    (hF : IsUnit F) (y : n → ℝ) :
    y ∈ affineFixedTransitionReachabilityEllipsoid F c A B h hPos hF ↔
      y ∈ centeredInverseEllipsoidOfPosDef
        (pushForwardCovariance F (covariance A (B * B.transpose) h))
        (pushForwardCovariance_posDef F
          (covariance A (B * B.transpose) h) hF hPos) c := by
  exact affinePushForwardEllipsoid_mem_iff_centeredInverseEllipsoid
    F c (⟨hPos⟩ : LicensedInverseEllipsoid
      (covariance A (B * B.transpose) h)) hF y

end

end NoeticDiffusion
