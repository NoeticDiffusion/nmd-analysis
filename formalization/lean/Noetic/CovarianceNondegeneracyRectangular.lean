import Mathlib.Data.Real.StarOrdered
import Mathlib.LinearAlgebra.Matrix.PosDef

/-!
# L7a: rectangular factor nondegeneracy

This module generalizes the finite factor-Gramian criterion to factors
`B k : Matrix n m ℝ`.  The Gramian acts on state directions in `n`, while
each transported factor direction lies in the possibly different space `m`:

`G = ∑ k, B k * B kᵀ`.

The theorem proves that `G` is positive definite exactly when every nonzero
state direction is detected by at least one factor transpose.  The proof is
coordinate-free at the matrix level and uses the explicit quadratic form
`∑ k, (B k)ᵀ v · (B k)ᵀ v`.  No square-factor, invertibility,
regularization, rank characterization, probabilistic, empirical, or
biological assumption is introduced.
-/

namespace NoeticDiffusion

noncomputable section

open scoped BigOperators Matrix

variable {n m ι : Type*} [Fintype n] [Fintype m] [Fintype ι]

/-! ## Rectangular factor Gramian -/

/-- The finite Gramian generated by rectangular real factor matrices. -/
def rectangularFactorGramian (B : ι → Matrix n m ℝ) : Matrix n n ℝ :=
  ∑ k ∈ (Finset.univ : Finset ι), B k * (B k).transpose

omit [Fintype n] in
private lemma rectangularFactorGramian_isHermitian
    (B : ι → Matrix n m ℝ) :
    (rectangularFactorGramian B).IsHermitian := by
  classical
  have htranspose : ∀ k, (B k).transpose = (B k)ᴴ := by
    intro k
    ext i j
    rfl
  unfold rectangularFactorGramian
  simp_rw [htranspose]
  simp only [Matrix.IsHermitian, Matrix.conjTranspose_sum,
    Matrix.conjTranspose_mul, Matrix.conjTranspose_conjTranspose]

private lemma rectangularFactorGramian_quadratic
    (B : ι → Matrix n m ℝ) (v : n → ℝ) :
    star v ⬝ᵥ (rectangularFactorGramian B *ᵥ v) =
      ∑ k ∈ (Finset.univ : Finset ι),
        star ((B k).transpose *ᵥ v) ⬝ᵥ ((B k).transpose *ᵥ v) := by
  classical
  unfold rectangularFactorGramian
  rw [Matrix.sum_mulVec]
  simp only [dotProduct_sum]
  apply Finset.sum_congr rfl
  intro k hk
  rw [show (B k).transpose = (B k)ᴴ by
      ext i j
      rfl]
  rw [← Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec,
    show star v ᵥ* B k = star ((B k)ᴴ *ᵥ v) by
      rw [show B k = (B k)ᴴᴴ by simp, Matrix.vecMul_conjTranspose]
      simp]

omit [Fintype ι] in
private lemma rectangularFactorGramian_term_nonneg
    (B : ι → Matrix n m ℝ) (v : n → ℝ) (k : ι) :
    0 ≤ star ((B k).transpose *ᵥ v) ⬝ᵥ ((B k).transpose *ᵥ v) := by
  simpa using dotProduct_star_self_nonneg ((B k).transpose *ᵥ v)

/-! ## Exact nondegeneracy criterion -/

/--
The rectangular factor Gramian is positive definite exactly when every
nonzero state direction has a nonzero transported factor direction.
-/
theorem rectangularFactorGramian_posDef_iff
    (B : ι → Matrix n m ℝ) :
    (rectangularFactorGramian B).PosDef ↔
      ∀ v : n → ℝ, v ≠ 0 → ∃ k : ι, (B k).transpose *ᵥ v ≠ 0 := by
  classical
  constructor
  · intro h v hv
    by_contra hnone
    push_neg at hnone
    have hzero : star v ⬝ᵥ (rectangularFactorGramian B *ᵥ v) = 0 := by
      rw [rectangularFactorGramian_quadratic]
      apply Finset.sum_eq_zero
      intro k hk
      have hkzero : (B k).transpose *ᵥ v = 0 := hnone k
      simp [hkzero]
    have hpos := h.2 v hv
    rw [hzero] at hpos
    exact (lt_irrefl 0 hpos)
  · intro h
    refine ⟨rectangularFactorGramian_isHermitian B, ?_⟩
    intro v hv
    obtain ⟨k, hk⟩ := h v hv
    rw [rectangularFactorGramian_quadratic]
    have hterm :
        0 < star ((B k).transpose *ᵥ v) ⬝ᵥ ((B k).transpose *ᵥ v) :=
      Matrix.dotProduct_star_self_pos_iff.mpr hk
    exact Finset.sum_pos'
      (fun j _ => rectangularFactorGramian_term_nonneg B v j)
      ⟨k, Finset.mem_univ k, hterm⟩

end

end NoeticDiffusion
