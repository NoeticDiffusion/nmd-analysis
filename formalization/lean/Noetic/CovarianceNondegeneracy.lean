import Mathlib.Data.Real.StarOrdered
import Mathlib.LinearAlgebra.Matrix.PosDef
import Noetic.Covariance

/-!
# Finite-factor nondegeneracy of covariance Gramians

For a finite family of factor matrices `B k`, this module studies
`∑ k, B k * B kᵀ`.  The main criterion says that the Gramian is positive
definite exactly when every nonzero direction is detected by at least one
factor: `(B k)ᵀ *ᵥ v ≠ 0` for some `k`.

This is the finite-dimensional singular-covariance gate.  It is stated at
the factor/Gramian level, so it does not assume that an innovation covariance
has an invertible square root and does not introduce regularization.  The
fixed-transition `Q = B Bᵀ` specialization is included for square factors.
The rank/span reformulation and all probabilistic, empirical, or biological
claims remain separate later gates.
-/

namespace NoeticDiffusion

noncomputable section

open scoped BigOperators Matrix

variable {n ι : Type*} [Fintype n] [Fintype ι]

local instance covarianceNondegeneracyDecidableEq : DecidableEq n := Classical.decEq n

/-! ## Factor Gramian and quadratic-form identities -/

/-- The finite Gramian generated by a family of real factor matrices. -/
def factorGramian (B : ι → Matrix n n ℝ) : Matrix n n ℝ :=
  ∑ k ∈ (Finset.univ : Finset ι), B k * (B k).transpose

/-- The factor transported by `k` steps of a fixed transition. -/
def fixedTransitionFactors (A B : Matrix n n ℝ) (k : ℕ) : Matrix n n ℝ :=
  (A ^ k) * B

/-- The fixed-transition Gramian with `Q = B * Bᵀ` is a factor Gramian over
the finite horizon. -/
theorem fixedTransitionGramian_eq_factorGramian
    (A B : Matrix n n ℝ) (h : ℕ) :
    factorGramian (fun k : Fin h => fixedTransitionFactors A B k) =
      gramian A (B * B.transpose) h := by
  classical
  unfold gramian
  simp only [factorGramian, fixedTransitionFactors, real_conjTranspose]
  rw [Finset.sum_fin_eq_sum_range]
  apply Finset.sum_congr rfl
  intro x hx
  rw [dif_pos (Finset.mem_range.mp hx)]
  simp only [Matrix.transpose_mul, Matrix.mul_assoc]

private lemma factorGramian_isHermitian (B : ι → Matrix n n ℝ) :
    (factorGramian B).IsHermitian := by
  classical
  unfold factorGramian
  simp only [Matrix.IsHermitian, Matrix.conjTranspose_sum,
    Matrix.conjTranspose_mul, real_conjTranspose]
  rfl

private lemma factorGramian_quadratic (B : ι → Matrix n n ℝ) (v : n → ℝ) :
    star v ⬝ᵥ (factorGramian B *ᵥ v) =
      ∑ k ∈ (Finset.univ : Finset ι),
        star ((B k).transpose *ᵥ v) ⬝ᵥ ((B k).transpose *ᵥ v) := by
  classical
  unfold factorGramian
  rw [Matrix.sum_mulVec]
  simp only [dotProduct_sum]
  apply Finset.sum_congr rfl
  intro k hk
  rw [show (B k).transpose = (B k)ᴴ by
      ext i j
      rfl]
  rw [← Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec,
    show star v ᵥ* B k = star ((B k)ᴴ *ᵥ v) by
      rw [show B k = (B k)ᴴᴴ by simp, Matrix.vecMul_conjTranspose]
      simp]

omit [Fintype ι] in
private lemma factorGramian_term_nonneg
  (B : ι → Matrix n n ℝ) (v : n → ℝ) (k : ι) :
    0 ≤ star ((B k).transpose *ᵥ v) ⬝ᵥ ((B k).transpose *ᵥ v) := by
  simpa using dotProduct_star_self_nonneg ((B k).transpose *ᵥ v)

/-! ## Exact nondegeneracy criterion -/

/--
The factor Gramian is positive definite exactly when every nonzero direction
has a nonzero transported factor direction.
-/
theorem factorGramian_posDef_iff
    (B : ι → Matrix n n ℝ) :
    (factorGramian B).PosDef ↔
      ∀ v : n → ℝ, v ≠ 0 → ∃ k : ι, (B k).transpose *ᵥ v ≠ 0 := by
  classical
  constructor
  · intro h v hv
    by_contra hnone
    push_neg at hnone
    have hzero : star v ⬝ᵥ (factorGramian B *ᵥ v) = 0 := by
      rw [factorGramian_quadratic]
      apply Finset.sum_eq_zero
      intro k hk
      have hkzero : (B k).transpose *ᵥ v = 0 := hnone k
      simp [hkzero]
    have hpos := h.2 v hv
    rw [hzero] at hpos
    exact (lt_irrefl 0 hpos)
  · intro h
    refine ⟨factorGramian_isHermitian B, ?_⟩
    intro v hv
    obtain ⟨k, hk⟩ := h v hv
    rw [factorGramian_quadratic]
    have hterm :
        0 < star ((B k).transpose *ᵥ v) ⬝ᵥ ((B k).transpose *ᵥ v) :=
      Matrix.dotProduct_star_self_pos_iff.mpr hk
    exact Finset.sum_pos'
      (fun j _ => factorGramian_term_nonneg B v j)
      ⟨k, Finset.mem_univ k, hterm⟩

/-- For `Q = B * Bᵀ`, finite-horizon covariance is positive definite exactly
when the transported factors detect every nonzero state direction. -/
theorem covariance_posDef_iff_fixedTransition_detects
    (A B : Matrix n n ℝ) (h : ℕ) :
    (covariance A (B * B.transpose) h).PosDef ↔
      ∀ v : n → ℝ, v ≠ 0 → ∃ k : Fin h,
        (fixedTransitionFactors A B k).transpose *ᵥ v ≠ 0 := by
  rw [covariance_eq_gramian A (B * B.transpose) h,
    ← fixedTransitionGramian_eq_factorGramian A B h]
  exact factorGramian_posDef_iff _

end

end NoeticDiffusion
