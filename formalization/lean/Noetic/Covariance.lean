import Mathlib.LinearAlgebra.Matrix.PosDef

/-!
# Finite-horizon covariance propagation

This file formalizes the algebraic core of the NDT short-horizon local model.
The source equations are `Noetic Diffusion Theory Compendium.typ`,
`eq:compendium-reachability-model` (lines 932--935) and
`eq:compendium-reachability-recursion` (lines 945--952):

```text
x_(t + 1) = A_t x_t + b_t + epsilon_t
Sigma_t^(0) = 0
Sigma_t^(h + 1) = A_t Sigma_t^(h) A_t^top + W_(Q,t)
```

Here `A` is fixed over the finite horizon and `Q` is the one-step innovation
covariance.  The stochastic interpretation of this recurrence requires
separate assumptions (finite second moments, zero innovation mean,
`Cov epsilon = Q`, and zero state--innovation cross-covariance).  In
particular, independence is sufficient but stronger than the zero
cross-covariance needed for the covariance recursion.  Those probabilistic
assumptions are deliberately not encoded in this algebra-only file.

The compendium calls the resulting surface predictive spread and explicitly
gates it on local-model and innovation quality (lines 924--943 and 963--968).
The formal objects below therefore establish matrix identities and positivity;
they do not establish an empirical reachability claim or a biological
interpretation.

The use of `Matrix.PosSemidef` and `Matrix.PosDef` is intentional.  In the
real-valued setting, conjugate transpose is ordinary transpose.
-/

namespace NoeticDiffusion

open scoped BigOperators Matrix

/-- Over `ℝ`, the conjugate transpose used by the matrix positivity API is
ordinary transpose. -/
@[simp] theorem real_conjTranspose {n : Type*} (A : Matrix n n ℝ) :
    Aᴴ = A.transpose := by
  exact Matrix.conjTranspose_eq_transpose_of_trivial A

variable {n : Type*} [Fintype n]

/-! ## Local step and covariance sequence -/

/-- One fixed local linear covariance step, with real matrices. -/
def covStep (A C Q : Matrix n n ℝ) : Matrix n n ℝ :=
  A * C * Aᴴ + Q

/-- The covariance recursion with zero initial covariance. -/
def covariance (A Q : Matrix n n ℝ) : ℕ → Matrix n n ℝ
  | 0 => 0
  | h + 1 => covStep A (covariance A Q h) Q

@[simp] theorem covariance_zero (A Q : Matrix n n ℝ) : covariance A Q 0 = 0 := rfl

@[simp] theorem covariance_succ (A Q : Matrix n n ℝ) (h : ℕ) :
    covariance A Q (h + 1) = covStep A (covariance A Q h) Q := rfl

/-! ## Positivity and symmetry -/

theorem covStep_posSemidef {A C Q : Matrix n n ℝ}
    (hC : C.PosSemidef) (hQ : Q.PosSemidef) :
    (covStep A C Q).PosSemidef := by
  unfold covStep
  exact (hC.mul_mul_conjTranspose_same A).add hQ

theorem covariance_posSemidef (A Q : Matrix n n ℝ)
    (hQ : Q.PosSemidef) (h : ℕ) :
    (covariance A Q h).PosSemidef := by
  induction h with
  | zero => exact Matrix.PosSemidef.zero
  | succ h ih => exact covStep_posSemidef ih hQ

theorem covariance_isHermitian (A Q : Matrix n n ℝ)
    (hQ : Q.PosSemidef) (h : ℕ) :
    (covariance A Q h).IsHermitian :=
  (covariance_posSemidef A Q hQ h).isHermitian

/-- Since the entries are real, covariance matrices are symmetric. -/
theorem covariance_isSymm (A Q : Matrix n n ℝ)
    (hQ : Q.PosSemidef) (h : ℕ) :
    (covariance A Q h).IsSymm := by
  have hHerm := covariance_isHermitian A Q hQ h
  simpa only [Matrix.conjTranspose_eq_transpose_of_trivial] using hHerm.eq

theorem covStep_posDef {A C Q : Matrix n n ℝ}
    (hC : C.PosSemidef) (hQ : Q.PosDef) :
    (covStep A C Q).PosDef := by
  unfold covStep
  simpa [add_comm] using hQ.add_posSemidef (hC.mul_mul_conjTranspose_same A)

/-- A positive-definite innovation covariance makes every positive-horizon
covariance positive definite.  The zero-horizon covariance remains zero. -/
theorem covariance_posDef {A Q : Matrix n n ℝ}
    (hQ : Q.PosDef) {h : ℕ} (hh : 0 < h) :
    (covariance A Q h).PosDef := by
  cases h with
  | zero => simp at hh
  | succ h =>
      exact covStep_posDef (covariance_posSemidef A Q hQ.posSemidef h) hQ

/-! ## Finite Gramian form -/

section Gramian

variable [DecidableEq n]

/-- The finite Gramian generated by a fixed local transition matrix and
one-step innovation covariance. -/
def gramian (A Q : Matrix n n ℝ) (h : ℕ) : Matrix n n ℝ :=
  ∑ k ∈ Finset.range h, A ^ k * Q * (A ^ k)ᴴ

private lemma gramian_shift_term (A Q : Matrix n n ℝ) (k : ℕ) :
    A * (A ^ k * Q * (A ^ k)ᴴ) * Aᴴ =
      A ^ (k + 1) * Q * (A ^ (k + 1))ᴴ := by
  rw [pow_succ']
  simp only [Matrix.conjTranspose_mul, Matrix.mul_assoc]

private lemma gramian_shift_sum (A Q : Matrix n n ℝ) (h : ℕ) :
    (∑ k ∈ Finset.range h, A * (A ^ k * Q * (A ^ k)ᴴ) * Aᴴ) =
      ∑ k ∈ Finset.range h, A ^ (k + 1) * Q * (A ^ (k + 1))ᴴ := by
  induction h with
  | zero => simp
  | succ h ih =>
      rw [Finset.sum_range_succ, Finset.sum_range_succ, ih,
        gramian_shift_term]

private lemma sum_range_shift_add_zero {β : Type*} [AddCommMonoid β]
    (f : ℕ → β) (h : ℕ) :
    (∑ k ∈ Finset.range h, f (k + 1)) + f 0 =
      ∑ k ∈ Finset.range (h + 1), f k := by
  induction h with
  | zero => simp
  | succ h ih =>
      rw [Finset.sum_range_succ, Finset.sum_range_succ]
      simpa [add_assoc, add_comm, add_left_comm] using
        congrArg (fun z => z + f (h + 1)) ih

theorem covariance_eq_gramian (A Q : Matrix n n ℝ)
    (h : ℕ) : covariance A Q h = gramian A Q h := by
  induction h with
  | zero => simp [covariance, gramian]
  | succ h ih =>
      rw [covariance_succ, ih]
      unfold covStep gramian
      rw [Finset.mul_sum, Finset.sum_mul, gramian_shift_sum]
      have hshift :=
        sum_range_shift_add_zero
          (fun k => A ^ k * Q * (A ^ k)ᴴ) h
      simpa using hshift

/-! ## Zero cases and Loewner increments -/

omit [DecidableEq n] in
theorem covariance_eq_zero_of_Q_eq_zero (A : Matrix n n ℝ)
    {Q : Matrix n n ℝ} (hQ : Q = 0) (h : ℕ) : covariance A Q h = 0 := by
  subst Q
  induction h with
  | zero => simp [covariance]
  | succ h ih => simp [covariance, covStep, ih]

theorem gramian_zero (A Q : Matrix n n ℝ) : gramian A Q 0 = 0 := by
  simp [gramian]

/-- Each added horizon contributes a positive-semidefinite Gramian term.  This
is the Loewner increment statement written directly with the standard
`Matrix.PosSemidef` predicate, so it does not depend on a separate order
notation or on an invertibility assumption. -/
theorem covariance_succ_sub_posSemidef (A Q : Matrix n n ℝ)
    (hQ : Q.PosSemidef) (h : ℕ) :
    (covariance A Q (h + 1) - covariance A Q h).PosSemidef := by
  rw [covariance_eq_gramian A Q (h + 1),
    covariance_eq_gramian A Q h]
  unfold gramian
  rw [Finset.sum_range_succ]
  have hterm : (A ^ h * Q * (A ^ h)ᴴ).PosSemidef :=
    hQ.mul_mul_conjTranspose_same (A ^ h)
  simpa [sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using hterm

end Gramian

end NoeticDiffusion
